{
  "name": "vibeslayer-suite",
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "repository": "https://github.com/HusX99/vibe-slayer",
  "homepage": "https://husx99.github.io/vibe-slayer/",
  "description": "Multi-asset anti-reverse-engineering protection suite against AI reversing agents (Web, WASM, Data/AI Weights, 3D Spatial, plus Native/Desktop/Mobile reference kits)",
  "keywords": [
    "anti-reverse-engineering",
    "asset-protection",
    "software-protection",
    "ai-security",
    "webassembly",
    "safetensors",
    "aes-gcm",
    "aead",
    "webcrypto",
    "anti-tamper",
    "anti-scraping",
    "zero-dependency"
  ],
  "bin": {
    "vs": "./cli/vs.js",
    "vibeslayer-auto": "./cli/vs.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./authority": "./src/core/authority.js",
    "./auto": "./src/auto.js",
    "./web": "./src/products/web.js",
    "./web-client": "./src/client/web-client.js",
    "./wasm": "./src/products/wasm.js",
    "./wasm-client": "./src/client/wasm-client.js",
    "./spatial3d": "./src/products/spatial3d.js",
    "./spatial3d-client": "./src/client/spatial3d-client.js",
    "./native": "./src/products/native.js",
    "./desktop": "./src/products/desktop.js",
    "./mobile": "./src/products/mobile.js",
    "./data-ai": "./src/products/dataAi.js",
    "./data-ai-client": "./src/client/data-ai-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cli/",
    "src/",
    "native_src/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "test": "node --test test/suite.test.js",
    "coverage": "node --test --experimental-test-coverage test/suite.test.js",
    "bench": "node bench/benchmark-all-vs-bla.js"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
